{
  "manifest_version": 3,
  "name": "ck-banner",
  "version": "0.1.0",
  "description": "Compare a Card Kingdom sell cart with the price list, and export order and selling history as CSV.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ck-banner@mtgban.com",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cardkingdom.com/myaccount/order_history*",
        "https://www.cardkingdom.com/myaccount/selling_history*"
      ],
      "js": [
        "src/net.js",
        "src/money.js",
        "src/csv.js",
        "src/ui.js",
        "src/history.js",
        "src/historypage.js"
      ],
      "css": [
        "src/panel.css",
        "src/history.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cardkingdom.com/sellcart*",
        "https://www.cardkingdom.com/cart*"
      ],
      "js": [
        "src/net.js",
        "src/money.js",
        "src/ui.js",
        "src/cart.js",
        "src/prices.js",
        "src/store.js",
        "src/compare.js",
        "src/update.js",
        "src/cartpage.js"
      ],
      "css": [
        "src/panel.css",
        "src/cart.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
